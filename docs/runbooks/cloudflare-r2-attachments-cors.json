{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://my.phiguard.app",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": [
          "PUT",
          "GET",
          "HEAD"
        ],
        "headers": [
          "content-type"
        ]
      },
      "exposeHeaders": [
        "etag"
      ],
      "maxAgeSeconds": 300
    }
  ]
}
