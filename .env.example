# Database
DATABASE_URL=postgresql://phiguard:phiguard_dev@localhost:5432/phiguard

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me-use-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_TOKEN_KEY_ID=

# Email (Resend)
RESEND_API_KEY=re_placeholder_replace_with_real_key
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=angel.campa@phiguard.app

# App
NODE_ENV=development
PORT=3000

# Attachment object storage
# Local/dev direct-upload verification uses the runtime object-storage binding.
ATTACHMENTS_BUCKET_NAME=phiguard-attachments-dev
AUDIT_EXPORTS_BUCKET_NAME=phiguard-audit-exports-dev
LEAD_MAGNETS_BUCKET=phiguard-lead-magnets-dev
OBJECT_STORAGE_PUBLIC_ORIGIN=

# Attachment malware scanning
ATTACHMENT_SCAN_REQUEST_URL=
ATTACHMENT_SCAN_REQUEST_SECRET=
ATTACHMENT_SCAN_WEBHOOK_SECRET=

# Direct upload capability signing
DIRECT_UPLOAD_SECRET=

# Sentry (optional locally)
# Prefer separate DSNs in production. VITE_SENTRY_APP_DSN is public and must be
# available before the browser bundle is built.
# Legacy VITE_SENTRY_DSN remains a fallback.
SENTRY_API_DSN=
SENTRY_DSN=
VITE_SENTRY_APP_DSN=
VITE_SENTRY_DSN=
# Source-map upload during production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_RELEASE=
# Client environment label exposed to the browser bundle
VITE_APP_ENV=development

# PostHog analytics
# Product analytics is proxied through /api/analytics/product so authenticated
# app routes never load PostHog browser JavaScript directly.
PRODUCT_ANALYTICS_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Public marketing analytics is consent-gated and uses PostHog only on apps/marketing.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional local-only dashboard validation/sync credentials. Never commit a real value.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_ENVIRONMENT_ID=
POSTHOG_PERSONAL_API_KEY=

# Marketing runtime Sentry config
PUBLIC_SENTRY_MARKETING_DSN=
PUBLIC_SENTRY_DSN=
PUBLIC_APP_ENV=development

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy monthly price env vars retained for compatibility.
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_CLINIC=
STRIPE_PRICE_GROUP=
STRIPE_PRICE_COMPLIANCE_OPS=
# Current checkout price env vars.
STRIPE_PRICE_ESSENTIALS_MONTHLY=
STRIPE_PRICE_ESSENTIALS_ANNUAL=
STRIPE_PRICE_CLINIC_MONTHLY=
STRIPE_PRICE_CLINIC_ANNUAL=
STRIPE_PRICE_GROUP_MONTHLY=
STRIPE_PRICE_GROUP_ANNUAL=
STRIPE_PRICE_COMPLIANCE_OPS_MONTHLY=
STRIPE_PRICE_COMPLIANCE_OPS_ANNUAL=
STRIPE_M80OFF_COUPON_ID=
STRIPE_Y80OFF_COUPON_ID=

# OAuth and calendar integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_KEY_ID=

# App
APP_URL=http://localhost:3000

# AI customer success proxy
AI_CS_WORKER_ORIGIN=
AI_CS_CLIENT_ASSERTION_SECRET=
AI_CS_FREE_TEXT_ENABLED=false

# Public lead-capture abuse protection
PUBLIC_CAPTCHA_SITE_KEY=
PUBLIC_CAPTCHA_SCRIPT_URL=https://challenges.cloudflare.com/turnstile/v0/api.js
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Cloudflare Turnstile (canonical alias names used by marketing worker)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Marketing AI-SDR product context endpoint
AI_SDR_CONTEXT_SECRET=
# Marketing AI-SDR BFF client assertion HMAC key
AI_SDR_CLIENT_ASSERTION_SECRET=
# Marketing AI-SDR BFF upstream URL
AI_SDR_WORKER_URL=https://ai-sdr-worker.example.workers.dev

# Marketing site URL (used by apps/web to build thank-you redirect and delivery email links)
MARKETING_SITE_URL=http://localhost:4321

# Partner portal — HMAC token signing (generate with: openssl rand -hex 32)
PARTNER_TOKEN_SECRET=

# DataForSEO — keyword research and competitor gap analysis
# Credentials from app.dataforseo.com → API access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# CRM feedback widget
# Set VITE_CRM_WIDGET_KEY to the product-specific public widget key issued by the CRM.
# The key is not a secret (it is embedded in public HTML), but it should not be
# committed — set it in your deployment environment. Leave blank to disable the widget.
# VITE_CRM_LOADER_URL defaults to https://crm.example.com/w/v1.js; override only
# if pointing at a staging CRM instance.
VITE_CRM_WIDGET_KEY=
VITE_CRM_LOADER_URL=https://crm.example.com/w/v1.js
