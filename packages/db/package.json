{
  "name": "@phiguard/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./testing": "./src/testing/index.ts",
    "./tasks": "./src/tasks/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@phiguard/audit": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@phiguard/config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7",
    "vitest": "^2"
  }
}
