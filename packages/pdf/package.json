{
  "name": "@phiguard/pdf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "build:pdfs": "tsx scripts/build-and-upload.ts",
    "build:local": "cross-env PDF_LOCAL_ONLY=true tsx scripts/build-and-upload.ts"
  },
  "dependencies": {
    "@phiguard/baa": "workspace:*",
    "@phiguard/billing": "workspace:*",
    "@phiguard/brand": "workspace:*",
    "@phiguard/knowledge": "workspace:*",
    "@phiguard/lead-magnets": "workspace:*",
    "@phiguard/ui": "workspace:*",
    "@react-pdf/renderer": "^4.1.5",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@phiguard/config": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19.1.2",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7",
    "vitest": "^2"
  }
}
