{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phiguard-app",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/web/dist/worker.mjs",
  "assets": {
    "directory": "apps/web/dist/client",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "routes": [
    {
      "pattern": "my.phiguard.app",
      "custom_domain": true,
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://my.phiguard.app",
    "AI_CS_FREE_TEXT_ENABLED": "false",
    "AI_CS_WORKER_ORIGIN": "https://ai-cs.phiguard.app",
    "MARKETING_SITE_URL": "https://phiguard.app",
    "NODE_ENV": "production",
    "R2_ATTACHMENTS_BUCKET": "phiguard-attachments",
    "R2_AUDIT_EXPORTS_BUCKET": "phiguard-audit-exports",
    "R2_LEAD_MAGNETS_BUCKET": "phiguard-lead-magnets",
    "SEQUENCER_BASE_URL": "https://sequencer.example.com",
    "PRODUCT_ANALYTICS_ENABLED": "true",
    "SCHEDULED_JOBS_ENABLED": "true",
    "TRUSTED_PROXY": "true",
    "VITE_APP_ENV": "production",
    "VITE_POSTHOG_KEY": "phc_REPLACE_WITH_YOUR_POSTHOG_PROJECT_KEY",
    "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
    "VITE_SENTRY_APP_DSN": "",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_YOUR_HYPERDRIVE_ID",
    },
  ],
  "d1_databases": [
    {
      "binding": "MARKETING_DB",
      "database_name": "phiguard-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "packages/marketing-db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_ATTACHMENTS",
      "bucket_name": "phiguard-attachments",
    },
    {
      "binding": "R2_AUDIT_EXPORTS",
      "bucket_name": "phiguard-audit-exports",
    },
    {
      "binding": "R2_LEAD_MAGNETS",
      "bucket_name": "phiguard-lead-magnets",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
