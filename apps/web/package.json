{
  "name": "@phiguard/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "config": {
    "SENTRY_PROJECT": "phiguard-app-client"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node ./scripts/vite-build.mjs",
    "start": "vite preview",
    "deploy": "pnpm build && wrangler deploy --config ../../wrangler.jsonc",
    "cf:typegen": "wrangler types --config ../../wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:direct-uploads": "pnpm build && node ./scripts/playwright-direct-uploads.mjs",
    "test:mobile": "pnpm build && playwright test --project=mobile-320 --project=mobile-375 --project=mobile-414",
    "verify:lead-magnets": "tsx scripts/verify-lead-magnets.ts",
    "seed:dev": "tsx --env-file=.env scripts/dev-seed.ts",
    "seed:demo": "tsx --env-file=.env scripts/demo-seed.ts",
    "seed:prod": "tsx scripts/prod-seed.ts",
    "marketing:backfill": "echo \"Legacy marketing backfill has been removed; use Sequencer.\""
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.6",
    "@fontsource/besley": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/public-sans": "^5.2.7",
    "@phiguard/audit": "workspace:*",
    "@phiguard/auth": "workspace:*",
    "@phiguard/baa": "workspace:*",
    "@phiguard/billing": "workspace:*",
    "@phiguard/brand": "workspace:*",
    "@phiguard/compliance": "workspace:*",
    "@phiguard/db": "workspace:*",
    "@phiguard/email": "workspace:*",
    "@phiguard/integration": "workspace:*",
    "@phiguard/knowledge": "workspace:*",
    "@phiguard/lead-magnets": "workspace:*",
    "@phiguard/marketing-db": "workspace:*",
    "@phiguard/pdf": "workspace:*",
    "@phiguard/ui": "workspace:*",
    "@sentry/cloudflare": "^10.49.0",
    "@sentry/core": "^10.49.0",
    "@sentry/node": "^10.49.0",
    "@sentry/react": "^10.49.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "react": "^19",
    "react-dom": "^19",
    "svix": "^1.45.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@phiguard/config": "workspace:*",
    "@playwright/test": "^1.44.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-core": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "better-auth": "^1.6.3",
    "postgres": "^3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7",
    "vite": "^7",
    "vite-tsconfig-paths": "^6",
    "vitest": "^2.1.9"
  }
}
