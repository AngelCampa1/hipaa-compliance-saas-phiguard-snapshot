# URL of the PHIGuard app server — used by LeadMagnetForm to build the form action URL
# In production this is set to https://my.phiguard.app before deploy
PUBLIC_APP_URL=http://localhost:3000

# Sentry browser error monitoring for the static marketing site.
# Leave empty to disable locally.
PUBLIC_SENTRY_MARKETING_DSN=
# Backward-compatible fallback for existing Pages projects.
PUBLIC_SENTRY_DSN=
PUBLIC_APP_ENV=development

# PostHog analytics key — marketing site only. Never set this in apps/web.
PUBLIC_POSTHOG_KEY=

# Cloudflare Turnstile site key (public) for lead-capture/newsletter forms.
# Leave empty locally — the widget is skipped and the server bypasses
# verification when TURNSTILE_SECRET_KEY is unset.
PUBLIC_TURNSTILE_SITE_KEY=
