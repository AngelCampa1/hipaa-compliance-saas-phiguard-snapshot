        "http://localhost:4321/pricing",
        "http://localhost:4321/security",
        "http://localhost:4321/resources",
        "http://localhost:4321/resources/hipaa-risk-analysis-template",
        "http://localhost:4321/learn",
        "http://localhost:4321/learn/hipaa-basics/hipaa-task-management",
        "http://localhost:4321/contributors",
        "http://localhost:4321/unsubscribe"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.95}],
        "categories:accessibility": ["error", {"minScore": 0.90}],
        "categories:best-practices": ["error", {"minScore": 0.90}],
        "categories:seo": ["error", {"minScore": 0.95}]
      }
    }
  }
}
