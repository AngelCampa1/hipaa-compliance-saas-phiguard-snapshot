{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "phiguard-marketing",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "phiguard.app", "custom_domain": true },
    { "pattern": "www.phiguard.app", "custom_domain": true },
  ],
  "vars": {
    // Public analytics key — baked into client HTML at build time. Not a secret.
    "PUBLIC_POSTHOG_KEY": "phc_REPLACE_WITH_YOUR_POSTHOG_PROJECT_KEY",
    "PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "PUBLIC_APP_URL": "https://my.phiguard.app",
    // Cloudflare Turnstile site key — public, baked into client HTML at build
    // time. Create a Turnstile widget for phiguard.app in the Cloudflare
    // dashboard and paste the site key here, or provide it in the deploy environment.
    // Empty in both places fails the deploy build.
    "PUBLIC_CAPTCHA_SITE_KEY": "0xREPLACE_WITH_YOUR_TURNSTILE_SITE_KEY",
    // Canonical alias used by the marketing worker Turnstile verification path
    "PUBLIC_TURNSTILE_SITE_KEY": "0xREPLACE_WITH_YOUR_TURNSTILE_SITE_KEY",
    "PUBLIC_SENTRY_MARKETING_DSN": "",
    "PUBLIC_APP_ENV": "production",
    // AI-SDR BFF upstream — public URL, not a secret.
    "AI_SDR_WORKER_URL": "https://ai-sdr-worker.example.workers.dev",
  },
  "observability": {
    "enabled": true,
  },
}
