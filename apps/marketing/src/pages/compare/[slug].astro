---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import { PHIGUARD_PUBLIC_SITE_ORIGIN } from '@phiguard/brand/identity'
import MarketingLayout from '../../layouts/MarketingLayout.astro'
import CTA from '../../components/CTA.astro'
import CanonicalCommercialNote from '../../components/CanonicalCommercialNote.astro'
import FAQ from '../../components/FAQ.astro'
import ComparisonWinnerPositioning from '../../components/ComparisonWinnerPositioning.astro'
import LeadCapturePanel from '../../components/LeadCapturePanel.astro'
import RelatedContent from '../../components/RelatedContent.astro'
import { commercialKnowledgeCopy } from '@phiguard/knowledge/commercial'
import { resolveCanonicalContentCopy } from '../../lib/canonical-content-copy'
import { getContributor } from '../../lib/contributors'
import { buildBreadcrumbSchema, buildArticleSchema, buildFAQSchema } from '../../lib/seo'
import Breadcrumbs from '../../components/Breadcrumbs.astro'

export const prerender = true

export const getStaticPaths = (async () => {
  const entries = await getCollection('comparisons')
  return entries.map((entry: CollectionEntry<'comparisons'>) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }))
}) satisfies GetStaticPaths

type Props = { entry: CollectionEntry<'comparisons'> }
type ComparisonFaq = { q: string; a: string }
type SourceItem = { title: string; url: string; publisher?: string }

const { entry } = Astro.props as Props
const entrySlug = entry.id.replace(/\.md$/, '')
const { Content } = await render(entry)
const author = getContributor(entry.data.author)
const reviewer = getContributor(entry.data.reviewer)

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare' },
  { name: entry.data.title, url: `/compare/${entrySlug}` },
])

const articleSchema = buildArticleSchema({
  headline: entry.data.title,
  description: entry.data.metaDescription,
  url: `/compare/${entrySlug}`,
  datePublished: entry.data.publishedAt,
  dateModified: entry.data.updatedAt,
  authorName: author.name,
  authorUrl: `${PHIGUARD_PUBLIC_SITE_ORIGIN}/contributors/${author.slug}`,
  authorSameAs: author.sameAs,
  reviewerName: reviewer.name,
  reviewerUrl: `${PHIGUARD_PUBLIC_SITE_ORIGIN}/contributors/${reviewer.slug}`,
  citations: entry.data.sources,
})
const seoTitle = entrySlug === 'hipaa-compliance-software-comparison'
  ? 'HIPAA Compliance Software Comparison'
  : entry.data.competitors?.[0]
    ? `PHIGuard vs ${entry.data.competitors[0]}`
    : entry.data.title
const faqItems =
  entry.data.faq?.map((item: ComparisonFaq) => ({
    question: item.q,
    answer: resolveCanonicalContentCopy(item.a),
  })) ?? []
const faqSchema = faqItems.length
  ? buildFAQSchema(faqItems.map((item: { question: string; answer: string }) => ({ q: item.question, a: item.answer })))
  : null
const showWinnerPositioning = entrySlug.startsWith('phiguard-vs-')
---

<MarketingLayout
  title={`${entry.data.seoTitle ?? seoTitle} | PHIGuard`}
  description={entry.data.metaDescription}
  jsonLd={faqSchema ? [breadcrumbs, articleSchema, faqSchema] : [breadcrumbs, articleSchema]}
  canonicalUrl={`${PHIGUARD_PUBLIC_SITE_ORIGIN}/compare/${entrySlug}`}
  ogType="article"
  ogImage="https://phiguard.app/og/comparisons.png"
  publishedTime={entry.data.publishedAt.toISOString()}
  modifiedTime={entry.data.updatedAt.toISOString()}
>
  <section class="article-frame">
    <div class="shell-md">
      <div style="margin-bottom: 1.25rem;">
        <Breadcrumbs crumbs={[
          { label: "Home", href: "/" },
          { label: "Compare", href: "/compare" },
          { label: entry.data.title },
        ]} />
      </div>
      <h1 class="article-hero-title text-balance">{entry.data.title}</h1>
      {entry.data.description && <p class="article-lead">{entry.data.description}</p>}
      <div class="editorial-card" style="margin-top: 1.5rem;">
        <p class="panel-label">Decision summary</p>
        <p style="margin: 0;">{entry.data.summary}</p>
      </div>
    </div>
  </section>

  {showWinnerPositioning && <ComparisonWinnerPositioning variant="comparison" />}

  <section class="page-surface page-surface--tight">
    <div class="shell-md">
      <article class="article-prose max-w-none">
        <Content />
      </article>
      <CanonicalCommercialNote />
      <div class="editorial-card" style="margin-top: 1.5rem;">
        <p class="panel-label">Research details</p>
        <p><strong>Written by:</strong> <a href={`/contributors/${author.slug}`}>{author.name}</a></p>
        <p><strong>Reviewed by:</strong> <a href={`/contributors/${reviewer.slug}`}>{reviewer.name}</a></p>
        <p><strong>Updated:</strong> {entry.data.updatedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
        {entry.data.verificationDate && <p><strong>Vendor posture reviewed:</strong> {entry.data.verificationDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>}
      </div>
      <div class="editorial-card" style="margin-top: 1rem;">
        <p class="panel-label">Sources</p>
        <ul class="list-clean">
          {entry.data.sources.map((source: SourceItem) => (
            <li>
              <a href={source.url}>{source.title}</a>
              {source.publisher && <span> | {source.publisher}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="page-surface page-surface--tight">
    <div class="shell-md">
      <LeadCapturePanel magnetSlug="hipaa-pm-tool-comparison-guide" />
    </div>
  </section>

  {faqItems.length > 0 && <FAQ items={faqItems} heading="Questions buyers ask during this comparison" />}

  <RelatedContent
    cluster="comparisons"
    currentSlug={entrySlug}
    eyebrow="Keep narrowing the field"
    heading="Move from this comparison into a shortlist, worksheet, or the next PHIGuard decision page."
    items={[
      entry.data.relatedResource
        ? {
            href: `/resources/${entry.data.relatedResource}`,
            title: 'Download the supporting worksheet',
            description: 'Use the matching resource to keep the clinic’s evaluation concrete instead of anecdotal.',
            eyebrow: 'Downloadable resource',
          }
        : null,
      {
        href: '/compare',
        title: 'Browse every comparison and decision page',
        description: 'Return to the compare hub when the clinic needs to keep narrowing the field.',
        eyebrow: 'Parent hub',
      },
      entry.data.relatedLearnPath
        ? {
            href: entry.data.relatedLearnPath,
            title: 'Open the supporting explainer',
            description: 'Read the workflow background behind the comparison before the clinic commits to a tool category.',
            eyebrow: 'Background guide',
          }
        : null,
      entry.data.relatedCommercialPath
        ? {
            href: entry.data.relatedCommercialPath,
            title: 'Move to the next commercial step',
            description: 'Go deeper on the product, pricing, or a tighter comparison path once the shortlist is clearer.',
            eyebrow: 'Commercial path',
          }
        : {
            href: '/pricing',
            title: 'Compare PHIGuard pricing',
            description: commercialKnowledgeCopy.pricingModel,
            eyebrow: 'Commercial path',
          },
    ].filter(Boolean)}
  />

  <CTA />

<style>
  .article-prose :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
  .article-prose :global(pre) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
  .article-prose :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
</MarketingLayout>
