---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import { PHIGUARD_PUBLIC_SITE_ORIGIN } from '@phiguard/brand/identity'
import MarketingLayout from '../../../layouts/MarketingLayout.astro'
import CTA from '../../../components/CTA.astro'
import CanonicalCommercialNote from '../../../components/CanonicalCommercialNote.astro'
import FAQ from '../../../components/FAQ.astro'
import LeadCapturePanel from '../../../components/LeadCapturePanel.astro'
import RelatedContent from '../../../components/RelatedContent.astro'
import { resolveCanonicalContentCopy } from '../../../lib/canonical-content-copy'
import { getContributor } from '../../../lib/contributors'
import { buildArticleSchema, buildBreadcrumbSchema, buildFAQSchema, buildItemListSchema } from '../../../lib/seo'

type BestEntry = CollectionEntry<'best'>

export const prerender = true

export const getStaticPaths = (async () => {
  const entries = await getCollection('best')
  return entries.map((entry: BestEntry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props as { entry: BestEntry }
const { Content } = await render(entry)
const author = getContributor(entry.data.author)
const reviewer = getContributor(entry.data.reviewer)
type BestFaqItem = NonNullable<BestEntry['data']['faq']>[number]
type BestSource = BestEntry['data']['sources'][number]
type RankedItem = NonNullable<BestEntry['data']['rankedItems']>[number]
type ResourceEntry = CollectionEntry<'resources'>

const faqItems =
  entry.data.faq?.map((item: BestFaqItem) => ({
    question: item.q,
    answer: resolveCanonicalContentCopy(item.a),
  })) ?? []
const resourceEntries = await getCollection('resources')
const relatedResource = resourceEntries.find(
  (candidate: ResourceEntry) => candidate.data.magnetSlug === entry.data.relatedResource,
)
const slug = entry.id.replace(/\.md$/, '')

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources' },
  { name: 'Best', url: '/resources/best' },
  { name: entry.data.title, url: `/resources/best/${slug}` },
])

const articleSchema = buildArticleSchema({
  headline: entry.data.title,
  description: entry.data.metaDescription,
  url: `/resources/best/${slug}`,
  datePublished: entry.data.publishedAt,
  dateModified: entry.data.updatedAt,
  authorName: author.name,
  authorUrl: `${PHIGUARD_PUBLIC_SITE_ORIGIN}/contributors/${author.slug}`,
  authorSameAs: author.sameAs,
  reviewerName: reviewer.name,
  reviewerUrl: `${PHIGUARD_PUBLIC_SITE_ORIGIN}/contributors/${reviewer.slug}`,
  schemaType: 'BlogPosting',
  citations: entry.data.sources,
})

const faqSchema = faqItems.length
  ? buildFAQSchema(faqItems.map((item: { question: string; answer: string }) => ({ q: item.question, a: item.answer })))
  : null
const itemListSchema = entry.data.rankedItems?.length
  ? buildItemListSchema({
      name: entry.data.title,
      url: `/resources/best/${slug}`,
      items: entry.data.rankedItems,
    })
  : null
const jsonLd = [breadcrumbs, articleSchema, faqSchema, itemListSchema].filter(Boolean)
---

<MarketingLayout
  title={`${entry.data.seoTitle ?? entry.data.title} | PHIGuard`}
  description={entry.data.metaDescription}
  canonicalUrl={`${PHIGUARD_PUBLIC_SITE_ORIGIN}/resources/best/${slug}`}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime={entry.data.publishedAt.toISOString()}
  modifiedTime={entry.data.updatedAt.toISOString()}
>
  <article class="article-frame">
    <div class="shell-lg">
      <nav class="kicker" aria-label="Breadcrumb" style="margin-bottom: 1.25rem;">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/resources">Resources</a>
        <span>/</span>
        <a href="/resources/best">Best</a>
      </nav>

      <div class="section-grid" style="align-items: start;">
        <div>
          <p class="panel-label">{entry.data.category}</p>
          <h1 class="article-hero-title text-balance">{entry.data.title}</h1>
          <p class="article-lead">{entry.data.description}</p>
        </div>
        <aside class="sidebar-card">
          <p class="panel-label">Buying page notes</p>
          <p><strong>Written by:</strong> <a href={`/contributors/${author.slug}`}>{author.name}</a></p>
          <p><strong>Reviewed by:</strong> <a href={`/contributors/${reviewer.slug}`}>{reviewer.name}</a></p>
          <p><strong>Verified:</strong> {entry.data.verificationDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
          <p><strong>Updated:</strong> {entry.data.updatedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
          {entry.data.relatedCommercialPath && <p><strong>Compare next:</strong> <a href={entry.data.relatedCommercialPath}>Open the recommended next page</a></p>}
        </aside>
      </div>

      <div class="article-grid" style="margin-top: 2rem;">
        <div class="article-main">
          <div class="editorial-card" style="margin-bottom: 1.5rem;">
            <p class="panel-label">Decision summary</p>
            <p style="margin: 0;">{entry.data.summary}</p>
          </div>

          <div class="article-prose">
            <Content />
          </div>

          <CanonicalCommercialNote />

          {entry.data.rankedItems?.length ? (
            <section class="page-surface page-surface--tight" style="padding-left: 0; padding-right: 0;">
              <div class="editorial-card">
                <p class="panel-label">Shortlist at a glance</p>
                <ol class="m-0 pl-4">
                  {entry.data.rankedItems.map((item: RankedItem) => (
                    <li>
                      {item.url ? <a href={item.url}>{item.name}</a> : item.name}
                      <span> | {item.description}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          ) : null}

          <section class="page-surface page-surface--tight" style="padding-left: 0; padding-right: 0;">
            <div class="editorial-card">
              <p class="panel-label">Sources</p>
              <ul class="m-0 pl-4">
                {entry.data.sources.map((source: BestSource, index: number) => (
                  <li>
                    <a href={source.url} data-ph-source-link={index}>{source.title}</a>
                    {source.publisher && <span> | {source.publisher}</span>}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        </div>

        <aside class="resource-sidebar">
          <section class="sidebar-card">
            <h3>Key takeaways</h3>
            <ul class="m-0 pl-4">
              {entry.data.keyTakeaways.map((takeaway: string) => (
                <li>{takeaway}</li>
              ))}
            </ul>
          </section>

          {relatedResource && (
            <LeadCapturePanel
              variant="sidebar"
              magnetSlug={relatedResource.data.magnetSlug}
              ctaContext="inline-content-upgrade"
              eyebrow="Useful worksheet"
            />
          )}
        </aside>
      </div>
    </div>
  </article>

  {faqItems.length > 0 && <FAQ items={faqItems} heading="Questions clinics ask when narrowing a shortlist" />}

  <RelatedContent
    cluster="best"
    currentSlug={slug}
    eyebrow="Move toward selection"
    heading="Use the shortlist, then move into a worksheet, comparison, or the product path."
    items={[
      relatedResource
        ? {
            href: `/resources/${relatedResource.data.magnetSlug}`,
            title: relatedResource.data.title,
            description: relatedResource.data.description,
            eyebrow: 'Downloadable resource',
          }
        : null,
      {
        href: '/resources/best',
        title: 'Browse every best-of software shortlist',
        description: 'Return to the best-of hub when the clinic is still deciding which category belongs on the shortlist.',
        eyebrow: 'Parent hub',
      },
      entry.data.relatedCommercialPath
        ? {
            href: entry.data.relatedCommercialPath,
            title: 'Open the recommended next step',
            description: 'Move into pricing, the product page, a comparison, or another decision page once the shortlist is narrower.',
            eyebrow: 'Next page',
          }
        : {
            href: '/compare',
            title: 'Open the comparison hub',
            description: 'Continue from the shortlist into direct product comparisons and alternatives.',
            eyebrow: 'Decision center',
          },
      {
        href: '/compare',
        title: 'Compare PHIGuard against named options',
        description: 'Use the compare hub when the clinic is ready to evaluate a specific vendor or category head to head.',
        eyebrow: 'Comparison hub',
      },
    ].filter(Boolean)}
  />

  <CTA
    heading="Move from comparison pages to a safer operating system."
    subheading="PHIGuard is built for clinics that need a BAA, auditability, and recurring compliance work in one place instead of stitched across tools."
  />
</MarketingLayout>
