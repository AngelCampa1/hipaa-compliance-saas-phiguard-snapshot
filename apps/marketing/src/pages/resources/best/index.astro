---
import { getCollection, type CollectionEntry } from 'astro:content'
import { PHIGUARD_PUBLIC_SITE_ORIGIN } from '@phiguard/brand/identity'
import MarketingLayout from '../../../layouts/MarketingLayout.astro'
import { buildBreadcrumbSchema, buildCollectionPageSchema } from '../../../lib/seo'

type BestEntry = CollectionEntry<'best'>

const bestPages = (await getCollection('best')).sort(
  (a: BestEntry, b: BestEntry) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
)

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources' },
  { name: 'Best', url: '/resources/best' },
])
const collectionSchema = buildCollectionPageSchema({
  name: 'Best PHI and HIPAA Software Pages',
  description: 'Commercial shortlist pages for healthcare teams evaluating the best software for PHI handling, collaboration, and document sharing.',
  url: '/resources/best',
  items: bestPages.map((entry: BestEntry) => ({
    name: entry.data.title,
    url: `/resources/best/${entry.id.replace(/\.md$/, '')}`,
    description: entry.data.metaDescription,
  })),
})
---

<MarketingLayout
  title="Best PHI and HIPAA Software Pages | PHIGuard"
  description="Commercial comparison pages for healthcare teams evaluating the best PHI and HIPAA software by workflow fit, collaboration model, and document handling."
  canonicalUrl={`${PHIGUARD_PUBLIC_SITE_ORIGIN}/resources/best`}
  jsonLd={[breadcrumbs, collectionSchema]}
>
  <section class="hub-hero">
    <div class="hub-inner">
      <p class="hub-eyebrow">Best-for pages</p>
      <h1 class="hub-heading">Commercial HIPAA software pages for real buying decisions</h1>
      <p class="hub-subheading">
        These pages compare categories, pricing models, and operational tradeoffs so practice administrators can narrow their shortlist before they talk to sales teams.
      </p>
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-inner">
      <ul class="hub-list" role="list">
        {bestPages.map((entry: BestEntry) => (
          <li class="hub-list-item">
            <a href={`/resources/best/${entry.id.replace(/\.md$/, '')}`} class="hub-list-link">
              <span class="hub-item-label">{entry.data.category}</span>
              <span class="hub-list-title">{entry.data.title}</span>
              <span class="hub-list-desc">{entry.data.metaDescription}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</MarketingLayout>

<style is:global>
  .hub-hero {
    background: var(--phig-color-surface-50);
    border-bottom: 1px solid var(--phig-color-border-default);
    padding: 4rem 1.5rem 3rem;
    text-align: center;
  }
  .hub-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hub-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--phig-color-text-link);
    margin: 0 0 0.75rem;
  }
  .hub-heading {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--phig-color-text-primary);
    margin: 0 0 1rem;
    line-height: 1.15;
  }
  .hub-subheading {
    font-size: 1.0625rem;
    color: var(--phig-color-text-secondary);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
  }
  .hub-section {
    padding: 3rem 1.5rem;
  }
  .hub-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .hub-list-item {
    margin: 0;
  }
  .hub-list-link {
    display: block;
    text-decoration: none;
    border: 1px solid var(--phig-color-border-default);
    border-radius: 1rem;
    background: var(--phig-color-surface-0);
    padding: 1.15rem 1.2rem;
  }
  .hub-item-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--phig-color-text-link);
    margin-bottom: 0.45rem;
  }
  .hub-list-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--phig-color-text-primary);
    margin-bottom: 0.35rem;
  }
  .hub-list-desc {
    display: block;
    color: var(--phig-color-text-secondary);
    line-height: 1.6;
  }
</style>
