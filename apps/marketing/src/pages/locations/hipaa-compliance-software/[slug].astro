---
import { getCollection, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import StateGuideArticle from '../../../components/StateGuideArticle.astro'

type StateGuideEntry = CollectionEntry<'state-guides'>
type CityGuideEntry = CollectionEntry<'city-guides'>

export const prerender = true

export const getStaticPaths = (async () => {
  const entries = (await getCollection('state-guides')).filter(
    (entry: StateGuideEntry) => entry.data.pageFamily === 'compliance-software',
  )
  return entries.map((entry: StateGuideEntry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props as { entry: StateGuideEntry }
const data = entry.data
const allStateGuides = await getCollection('state-guides')
const breachGuide = allStateGuides.find(
  (guide: StateGuideEntry) => guide.data.pageFamily === 'breach-notification' && guide.data.slug === data.slug,
)
const allCityGuides = await getCollection('city-guides')
const cityBySlug = new Map(allCityGuides.map((guide: CityGuideEntry) => [guide.id, guide]))
const relatedCities = data.relatedCitySlugs
  .map((slug: string) => cityBySlug.get(slug))
  .filter(Boolean) as CityGuideEntry[]

const relatedItems = [
  breachGuide && {
    href: `/locations/hipaa-breach-notification/${breachGuide.data.slug}`,
    title: `${data.state} HIPAA breach notification guide`,
    description: breachGuide.data.metaDescription,
    eyebrow: 'State breach workflow',
  },
  ...relatedCities.map((guide: CityGuideEntry) => ({
    href: `/locations/hipaa-compliance/${guide.id}`,
    title: `${guide.data.city}, ${guide.data.stateAbbreviation} HIPAA compliance guide`,
    description: guide.data.metaDescription,
    eyebrow: 'City guide',
  })),
  {
    href: '/locations/hipaa-compliance-software',
    title: 'HIPAA compliance software by state',
    description: 'Browse all state commercial software pages for clinics.',
    eyebrow: 'Parent hub',
  },
].filter(Boolean)
---

<StateGuideArticle
  entry={entry}
  hubPath="/locations/hipaa-compliance-software"
  hubLabel="HIPAA compliance software by state"
  familyLabel="Commercial software"
  relatedItems={relatedItems}
/>
