---
import MarketingLayout from '../layouts/MarketingLayout.astro'
import { SUPPORT_EMAIL } from '@phiguard/knowledge/support'
---

<MarketingLayout
  title="Server Error | PHIGuard"
  description="PHIGuard could not load this page. Try again in a moment or contact support if the issue continues."
  noindex={true}
>
  <section class="flex flex-col items-center justify-center px-4 py-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-blue-600 mb-4">500</p>
    <h1 class="text-3xl font-bold text-text-primary mb-4">Unexpected server error.</h1>
    <p class="text-lg text-text-secondary mb-8 max-w-md">
      Something went wrong on our end. Please try again in a moment. If the issue continues, contact us at <a href={`mailto:${SUPPORT_EMAIL}`} class="underline" style="overflow-wrap: anywhere;">{SUPPORT_EMAIL}</a>.
    </p>
    <a
      href="/"
      class="utility-button"
    >
      Back to PHIGuard home
    </a>
  </section>
</MarketingLayout>
