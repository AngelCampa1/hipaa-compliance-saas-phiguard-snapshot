---
import MarketingLayout from '../layouts/MarketingLayout.astro'
---

<MarketingLayout
  title="Page Not Found | PHIGuard"
  description="The page you are looking for does not exist or has moved."
  noindex={true}
>
  <section class="flex flex-col items-center justify-center px-4 py-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-blue-600 mb-4">404</p>
    <h1 class="text-3xl font-bold text-text-primary mb-4">That page can't be found.</h1>
    <p class="text-lg text-text-secondary mb-8 max-w-md">
      The page you're looking for has moved or no longer exists. If you were looking for PHIGuard's HIPAA compliance resources, start from our home page.
    </p>
    <a
      href="/"
      class="utility-button"
    >
      Back to PHIGuard home
    </a>
  </section>
</MarketingLayout>
