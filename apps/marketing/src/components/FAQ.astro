---
import { publicTrustFaqs } from '@phiguard/knowledge/legal-trust'

interface FAQItem {
  question: string
  answer: string
}

interface Props {
  items?: FAQItem[]
  heading?: string
}

const defaultFAQs: FAQItem[] = [...publicTrustFaqs]

const {
  items = defaultFAQs,
  heading = 'Common questions from practice administrators',
} = Astro.props
---

<section class="page-surface page-surface--tight">
  <div class="shell-md">
    <p class="kicker">FAQ</p>
    <h2 class="section-title text-balance">{heading}</h2>
    <div class="faq-list">
      {items.map((item, idx) => (
        <details
          class:list={['faq-item group', idx === 0 && 'faq-item--first']}
          name="faq"
        >
          <summary class="faq-summary">
            {item.question}
            <svg
              class="faq-chevron group-open:rotate-180"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    border-radius: 1.2rem;
    overflow: hidden;
    border: 1px solid var(--phig-color-border-default);
    background: color-mix(
      in oklch,
      var(--phig-color-surface-0) 82%,
      var(--phig-color-brand-50)
    );
  }

  .faq-item {
    border-bottom: 1px solid var(--phig-color-surface-200);
  }

  .faq-item:last-child {
    border-bottom: 0;
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem; /* 44px tap target */
    padding: 1.1rem 1.2rem;
    color: var(--phig-color-text-primary);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 700;
    list-style: none;
    user-select: none;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    background: color-mix(in oklch, var(--phig-color-brand-50) 58%, transparent);
  }

  .faq-summary:focus-visible {
    outline-offset: -4px;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--phig-color-surface-400);
    transition: transform var(--phig-transition-fast);
  }

  .faq-answer {
    padding: 0 1.2rem 1.2rem;
  }

  .faq-answer p {
    margin: 0;
    color: var(--phig-color-text-secondary);
    font-size: var(--phig-font-size-body);
    line-height: var(--phig-line-height-loose);
  }
</style>
