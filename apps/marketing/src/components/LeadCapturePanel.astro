---
import {
  getLeadMagnetBySlug,
  LEAD_MAGNETS_BY_SLUG,
  type LeadCaptureCtaContext,
  type LeadMagnetSlug,
} from '@phiguard/lead-magnets'
import { PHIGUARD_APP_ORIGIN } from '@phiguard/brand/identity'
import TurnstileWidget from './TurnstileWidget.astro'

interface Props {
  magnetSlug?: LeadMagnetSlug
  pickerSlugs?: LeadMagnetSlug[]
  variant?: 'inline' | 'sidebar' | 'popup'
  ctaContext?: LeadCaptureCtaContext
  eyebrow?: string
  heading?: string
  body?: string
  buttonLabel?: string
  browseHref?: string
  browseLabel?: string
}

const {
  magnetSlug,
  pickerSlugs = [],
  variant = 'inline',
  ctaContext = 'inline-content-upgrade',
  eyebrow,
  heading,
  body,
  buttonLabel,
  browseHref = '/resources',
  browseLabel = 'Browse all resources',
} = Astro.props

const resolvedMagnetSlug = magnetSlug ?? pickerSlugs[0]
if (!resolvedMagnetSlug || !(resolvedMagnetSlug in LEAD_MAGNETS_BY_SLUG)) {
  throw new Error('LeadCapturePanel requires a valid magnetSlug or pickerSlugs prop.')
}

const selectedMagnet = getLeadMagnetBySlug(resolvedMagnetSlug)
const pickerMagnets = pickerSlugs.map((slug: LeadMagnetSlug) => getLeadMagnetBySlug(slug))
const appUrl = import.meta.env.PUBLIC_APP_URL ?? PHIGUARD_APP_ORIGIN
const apiUrl = `${appUrl}/api/marketing/leads`
const panelEyebrow = eyebrow ?? selectedMagnet.inlineCopy.eyebrow
const panelHeading = heading ?? selectedMagnet.inlineCopy.heading
const panelBody = body ?? selectedMagnet.inlineCopy.body
const panelButtonLabel = buttonLabel ?? selectedMagnet.inlineCopy.buttonLabel
---

<section class={`lead-capture lead-capture--${variant}`} data-lead-conversion={variant}>
  <div class="lead-capture__copy">
    <p class="lead-capture__eyebrow">{panelEyebrow}</p>
    <h2 class="lead-capture__heading">{panelHeading}</h2>
    <p class="lead-capture__body">{panelBody}</p>
  </div>

  <form
    class="lead-capture__form"
    action={apiUrl}
    method="POST"
    aria-label="Get free resource"
    data-lead-capture-form
  >
    {pickerMagnets.length === 0 && (
      <input type="hidden" name="magnetSlug" value={resolvedMagnetSlug} data-lead-magnet-input />
    )}
    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_medium" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="utm_content" value="" />
    <input type="hidden" name="referrer" value="" />
    <input type="hidden" name="source_page_path" value="" />
    <input type="hidden" name="cta_context" value={ctaContext} />

    <div class="lead-capture__hp" aria-hidden="true">
      <label for={`lead-company-${variant}-${resolvedMagnetSlug}`}>Company website</label>
      <input
        type="text"
        id={`lead-company-${variant}-${resolvedMagnetSlug}`}
        name="company_website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    {pickerMagnets.length > 0 && (
      <fieldset class="lead-capture__picker">
        <legend class="sr-only">Choose a resource</legend>
        {pickerMagnets.map((magnet, index) => (
          <label class="lead-capture__option">
            <input
              type="radio"
              name="magnetSlug"
              value={magnet.slug}
              checked={index === 0}
              data-lead-magnet-choice
            />
            <span class="lead-capture__option-title">{magnet.title}</span>
            <span class="lead-capture__option-copy">{magnet.inlineCopy.body}</span>
          </label>
        ))}
      </fieldset>
    )}

    <div class="lead-capture__controls">
      <label for={`lead-email-${variant}-${resolvedMagnetSlug}`} class="sr-only">Email address</label>
      <input
        type="email"
        id={`lead-email-${variant}-${resolvedMagnetSlug}`}
        name="email"
        placeholder="your@clinic.com"
        required
        class="lead-capture__input form-field"
        autocomplete="email"
      />
      <button type="submit" class="lead-capture__button" data-lead-capture-submit data-default-label={panelButtonLabel}>{panelButtonLabel}</button>
    </div>

    <TurnstileWidget />

    <p class="lead-capture__status" role="status" aria-live="polite" data-lead-capture-status hidden></p>
  </form>

  <div class="lead-capture__footer">
    <p class="lead-capture__reassurance">We will send the resource to your inbox.</p>
    <a href={browseHref} class="lead-capture__browse">{browseLabel}</a>
  </div>
</section>

<script>
  ;(() => {
    const params = new URLSearchParams(window.location.search)
    const forms = document.querySelectorAll<HTMLFormElement>('[data-lead-capture-form]')

    forms.forEach((form) => {
      if (form.dataset.leadCaptureEnhanced === 'true') return
      form.dataset.leadCaptureEnhanced = 'true'

      const set = (name: string, value: string) => {
        const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]`)
        if (input) input.value = value
      }
      const getReferrerHost = () => {
        if (!document.referrer) return ''
        try {
          return new URL(document.referrer).host
        } catch {
          return ''
        }
      }
      const getFirstTouch = () => {
        try {
          return JSON.parse(
            window.localStorage.getItem('phiguard_analytics_first_touch')
              ?? window.sessionStorage.getItem('phiguard_analytics_first_touch')
              ?? '{}',
          ) as Record<string, string>
        } catch {
          return {}
        }
      }

      set('utm_source', params.get('utm_source') ?? '')
      set('utm_medium', params.get('utm_medium') ?? '')
      set('utm_campaign', params.get('utm_campaign') ?? '')
      set('utm_content', params.get('utm_content') ?? '')
      set('utm_term', params.get('utm_term') ?? '')
      set('referrer', getReferrerHost())
      set('source_page_path', window.location.pathname)

      const firstTouch = getFirstTouch()
      set('landing_page_path', firstTouch.landing_path ?? window.location.pathname)
      set('initial_referrer_host', firstTouch.initial_referrer_host ?? getReferrerHost())
      set('initial_utm_source', firstTouch.initial_utm_source ?? params.get('utm_source') ?? '')
      set('initial_utm_medium', firstTouch.initial_utm_medium ?? params.get('utm_medium') ?? '')
      set('initial_utm_campaign', firstTouch.initial_utm_campaign ?? params.get('utm_campaign') ?? '')
      set('initial_utm_content', firstTouch.initial_utm_content ?? params.get('utm_content') ?? '')
      set('initial_utm_term', firstTouch.initial_utm_term ?? params.get('utm_term') ?? '')

      const button = form.querySelector<HTMLButtonElement>('[data-lead-capture-submit]')
      const status = form.querySelector<HTMLParagraphElement>('[data-lead-capture-status]')
      const defaultLabel = button?.dataset.defaultLabel ?? button?.textContent ?? 'Send'

      const setStatus = (message: string, tone: 'info' | 'success' | 'error') => {
        if (!status) return
        status.textContent = message
        status.hidden = !message
        status.dataset.tone = tone
      }

      const getAnalyticsContext = () => {
        const formData = new FormData(form)
        return {
          magnet_slug: String(formData.get('magnetSlug') ?? ''),
          cta_context: String(formData.get('cta_context') ?? ''),
          variant: (form.closest('[data-lead-conversion]') as HTMLElement | null)?.dataset.leadConversion,
        }
      }
      const getFieldCountCompleted = () => {
        const formData = new FormData(form)
        const hasEmail = String(formData.get('email') ?? '').trim().length > 0
        const hasMagnet = String(formData.get('magnetSlug') ?? '').trim().length > 0
        return [hasEmail, hasMagnet].filter(Boolean).length
      }

      const getAnalytics = () => (window as unknown as { phiguardAnalytics?: {
        identifyLead?: (identity: { email: string; leadId?: string }) => void
        track?: (event: string, props?: Record<string, unknown>) => void
      } }).phiguardAnalytics
      let hasTrackedStart = false
      let startedAt = 0
      let submitted = false
      let hasFailedSubmission = false
      const trackStart = () => {
        if (hasTrackedStart) return
        hasTrackedStart = true
        startedAt = Date.now()
        const analytics = getAnalytics()
        analytics?.track?.('lead_capture_started', getAnalyticsContext())
      }

      if (params.get('error') === 'delivery-failed') {
        setStatus("We couldn't send the resource right now. Please try again.", 'error')
      } else if (params.get('error') === 'verification') {
        setStatus("Couldn't verify you're human. Please try again.", 'error')
      }

      form.addEventListener('focusin', trackStart)
      form.addEventListener('input', trackStart)
      form.querySelectorAll<HTMLInputElement>('[data-lead-magnet-choice]').forEach((choice) => {
        choice.addEventListener('change', () => {
          const analytics = getAnalytics()
          analytics?.track?.('lead_magnet_choice_changed', {
            ...getAnalyticsContext(),
            field_count_completed: getFieldCountCompleted(),
          })
        })
      })
      form.addEventListener('invalid', (event) => {
        const field = event.target instanceof HTMLInputElement && event.target.name === 'email'
          ? 'email'
          : 'other'
        const analytics = getAnalytics()
        analytics?.track?.('lead_capture_validation_failed', {
          ...getAnalyticsContext(),
          field,
          reason: 'invalid_form',
          field_count_completed: getFieldCountCompleted(),
        })
      }, true)

      window.addEventListener('pagehide', () => {
        if (!hasTrackedStart || submitted) return
        const analytics = getAnalytics()
        analytics?.track?.('lead_capture_abandoned', {
          ...getAnalyticsContext(),
          field_count_completed: getFieldCountCompleted(),
        })
      })

      form.addEventListener('submit', async (event) => {
        if (!form.action) return
        event.preventDefault()
        if (!button) return
        trackStart()

        const formData = new FormData(form)
        const email = String(formData.get('email') ?? '')
        const magnetSlug = String(formData.get('magnetSlug') ?? '')
        const ctaContext = String(formData.get('cta_context') ?? '')
        const variant = (form.closest('[data-lead-conversion]') as HTMLElement | null)?.dataset.leadConversion
        const analytics = getAnalytics()
        const timeToSubmitMs = startedAt ? Date.now() - startedAt : 0
        let trackedFailure = false

        if (hasFailedSubmission) {
          analytics?.track?.('form_retry_clicked', {
            magnet_slug: magnetSlug,
            cta_context: ctaContext,
            variant,
          })
        }

        button.disabled = true
        button.textContent = 'Sending...'
        setStatus('', 'info')
        analytics?.track?.('lead_capture_submitted', {
          magnet_slug: magnetSlug,
          cta_context: ctaContext,
          variant,
          time_to_submit_ms: timeToSubmitMs,
          field_count_completed: getFieldCountCompleted(),
        })

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          })

          if (response.ok) {
            const result = await response.clone().json().catch(() => null) as { leadId?: string; id?: string } | null
            analytics?.identifyLead?.({ email, leadId: result?.leadId ?? result?.id })
            analytics?.track?.('lead_captured', {
              magnet_slug: magnetSlug,
              cta_context: ctaContext,
              variant,
              http_status: response.status,
              time_to_submit_ms: timeToSubmitMs,
            })
            submitted = true

            form.dispatchEvent(
              new CustomEvent('lead-capture:success', {
                bubbles: true,
                detail: {
                  magnetSlug,
                  ctaContext,
                  variant,
                },
              }),
            )
            form.reset()
            button.textContent = 'Sent'
            setStatus('Check your inbox. The resource is on its way.', 'success')
            return
          }

          analytics?.track?.('lead_capture_failed', {
            magnet_slug: magnetSlug,
            cta_context: ctaContext,
            variant,
            http_status: response.status,
            reason: 'request_failed',
          })
          trackedFailure = true
          throw new Error(`Request failed with status ${response.status}`)
        } catch (error) {
          if (!trackedFailure) {
            analytics?.track?.('lead_capture_failed', {
              magnet_slug: magnetSlug,
              cta_context: ctaContext,
              variant,
              reason: 'network_error',
            })
          }
          hasFailedSubmission = true
          button.disabled = false
          button.textContent = defaultLabel
          setStatus("Couldn't send right now. Please try again.", 'error')
        }
      })
    })
  })()
</script>

<style>
  .lead-capture {
    display: grid;
    gap: 1.2rem;
    border: 1px solid color-mix(in oklch, var(--phig-color-brand-200) 42%, var(--phig-color-border-default));
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at top right, color-mix(in oklch, var(--phig-color-brand-100) 62%, transparent) 0%, transparent 42%),
      linear-gradient(180deg, color-mix(in oklch, var(--phig-color-brand-50) 55%, var(--phig-color-surface-0)) 0%, var(--phig-color-surface-0) 100%);
    padding: 1.4rem;
    box-shadow: 0 18px 40px -30px color-mix(in oklch, var(--phig-color-brand-700) 35%, transparent);
  }

  .lead-capture__copy {
    display: grid;
    gap: 0.5rem;
  }

  .lead-capture__eyebrow {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--phig-color-text-muted);
  }

  .lead-capture__heading {
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    line-height: 1.1;
    color: var(--phig-color-text-primary);
  }

  .lead-capture__body {
    margin: 0;
    color: var(--phig-color-text-secondary);
    line-height: 1.65;
  }

  .lead-capture__form {
    display: grid;
    gap: 1rem;
  }

  .lead-capture__picker {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lead-capture__option {
    display: grid;
    gap: 0.25rem;
    padding: 0.95rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--phig-color-border-default);
    background: color-mix(in oklch, var(--phig-color-surface-0) 92%, var(--phig-color-brand-50));
    cursor: pointer;
  }

  .lead-capture__option:has(input:checked) {
    border-color: var(--phig-color-brand-400);
    background: color-mix(in oklch, var(--phig-color-brand-50) 72%, var(--phig-color-surface-0));
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--phig-color-brand-200) 35%, transparent);
  }

  .lead-capture__option input {
    margin: 0 0 0.2rem;
  }

  .lead-capture__option-title {
    font-weight: 700;
    color: var(--phig-color-text-primary);
  }

  .lead-capture__option-copy {
    color: var(--phig-color-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .lead-capture__controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .lead-capture__controls {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .lead-capture__input {
    flex: 1;
    min-width: 0;
    border-radius: 999px;
    border: 1px solid var(--phig-color-border-strong);
    background: color-mix(in oklch, var(--phig-color-surface-0) 92%, var(--phig-color-brand-50));
    color: var(--phig-color-text-primary);
    padding: 0.95rem 1rem;
    font: inherit;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .lead-capture__input:focus {
    border-color: var(--phig-color-border-focus);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--phig-color-brand-200) 35%, transparent);
  }

  .lead-capture__button {
    min-height: 3.2rem;
    border: 0;
    border-radius: 999px;
    background: var(--phig-color-brand-700);
    color: var(--phig-color-text-inverse);
    padding: 0.85rem 1.3rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .lead-capture__button:hover {
    background: var(--phig-color-brand-800);
    transform: translateY(-1px);
  }

  .lead-capture__button:focus-visible {
    outline: 2px solid var(--phig-color-border-focus);
    outline-offset: 4px;
    box-shadow: var(--phig-shadow-focus-brand);
  }

  .lead-capture__button:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .lead-capture__status {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--phig-color-text-secondary);
  }

  .lead-capture__status[data-tone='success'] {
    color: var(--phig-color-success-700);
  }

  .lead-capture__status[data-tone='error'] {
    color: var(--phig-color-danger-700);
  }

  .lead-capture__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
  }

  .lead-capture__reassurance {
    margin: 0;
    color: var(--phig-color-text-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .lead-capture__browse {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--phig-color-brand-700);
    font-weight: 700;
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Honeypot: kept in the layout but visually removed and out of tab order.
     Real users never see or fill it; bots that autofill all inputs do. */
  .lead-capture__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 639px) {
    .lead-capture__button,
    .lead-capture__input {
      width: 100%;
    }
  }
</style>
